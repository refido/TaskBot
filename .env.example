# Website URL
URL_APPLICATION=https://your-app.example

# Browser mode: TRUE/True/1 runs headless; FALSE/False/0 shows the browser.
HEADLESS=True

# Playwright interaction diagnostics. Debug captures traces, DOM/state logs,
# screenshots, and network timing. Pause opens Playwright Inspector at the
# diagnostic checkpoints and requires both debug mode and HEADLESS=False.
TASKBOT_INTERACTION_DEBUG=0
TASKBOT_INTERACTION_PAUSE=0

# NIK privacy mode: true/1/on/yes masks logs, reports, CLI output and artifact
# names. false/0/off/no shows valid NIK values. Runtime defaults to masking when
# MASK is absent. Email, PIN, passwords and tokens are always redacted.
MASK=0

# Multi-account credentials (recommended for threaded runs)
OPERATOR_1_ID=operator_01
EMAIL_1=first.operator@example.com
PIN_1=123456
NIK_1=1234567890123456,2345678901234567

OPERATOR_2_ID=operator_02
EMAIL_2=second.operator@example.com
PIN_2=654321
NIK_2=3456789012345678,4567890123456789

# One application-wide pacing channel for customer-data-update mutations and
# the same-NIK restart. This is independent of the skipped-NIK limiter.
CUSTOMER_UPDATE_MIN_INTERVAL_SECONDS=1.0
CUSTOMER_UPDATE_JITTER_SECONDS=0.25

# Structured logging (Loguru)
LOG_LEVEL=INFO
LOG_FILE_LEVEL=DEBUG
LOG_ROTATION=25 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=gz

# PostgreSQL database management
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskbot
DB_USER=taskbot
DB_PASSWORD=change-me

# Names stored in NAMA for each operator table.
# Configure only the numbered operator targets that actually exist. Stable
# OPERATOR_n_ID values are preferred for runtime report routing.
NAME_OPERATORS_1=First Operator
NAME_OPERATORS_2=Second Operator

# Backward-compatible single-account format (optional)
# EMAIL=you@example.com
# PIN=123456
# NIK=1234567890123456,2345678901234567,3456789012345678
# OPERATOR_ID=operator_01
